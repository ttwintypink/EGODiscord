# EGODiscord — пример файла окружения.
#
# Скопируйте этот файл в `.env` (на локальной машине)
# или задайте переменные через панель хостинга.
#
# Команда:
#   cp .env.example .env
# затем отредактируйте .env, подставив реальный токен.
#
# ВАЖНО: .env НИКОГДА не должен попадать в Git.
# Файл .env уже добавлен в .gitignore.

# Discord Bot Token (обязательно).
# Получить: https://discord.com/developers/applications -> Ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=ваш_токен_бота_здесь

# (Опционально) Steam Web API ключ — можно переопределить здесь,
# если не хотите хранить его в config.json.
# Получить: https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=YOUR_STEAM_WEB_API_KEY

# (Опционально) Discord ID разработчика бота (для команды .setup).
# Можно узнать, включив «Режим разработчика» в Discord и кликнув
# по своему аватару → Копировать ID.
# DEVELOPER_ID=1105559182624694393
